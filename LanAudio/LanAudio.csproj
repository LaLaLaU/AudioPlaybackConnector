<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AudioPlaybackConnectorLAN</AssemblyName>
    <RootNamespace>AudioPlaybackConnector.Lan</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\AudioPlaybackConnector.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <InternalsVisibleTo Include="LanAudio.Tests" />
  </ItemGroup>
</Project>
